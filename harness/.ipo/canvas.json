  "nodes": [
    {
      "id": "node_shooter_weapon_fire",
      "title": "Unity Shooter: Weapon Firing System",
      "category": "System Engine",
      "lifecycle_phase": "Update / Action Callback",
      "target_symbols": [
        "PlayerWeaponController.cs",
        "BulletPoolManager.cs",
        "AudioEventChannel.cs"
      ],
      "inputs": [
        "PlayerInput.Fire (InputAction)",
        "WeaponData ScriptableObject (FireRate, Damage, BulletPrefab)",
        "Transform MuzzlePoint"
      ],
      "process_execution_plan": [
        "1. Receive Fire input trigger in Update()",
        "2. Check fire cooldown timer against WeaponData.FireRate",
        "3. Request active bullet instance from BulletPoolManager",
        "4. Set bullet trajectory, damage payload, and velocity",
        "5. Raise AudioEventChannel.PlaySound(FireSFX)"
      ],
      "outputs": [
        "Bullet GameObject instantiated / activated",
        "MuzzleFlash VFX played",
        "OnWeaponFired C# Action event dispatched"
      ],
      "status": "READY_FOR_IMPLEMENTATION"
    },
    {
      "id": "node_shooter_damage_receiver",
      "title": "Unity Shooter: Health & Damage Receiver",
      "category": "Entity State",
      "lifecycle_phase": "OnTriggerEnter / Raycast Hit",
      "target_symbols": [
        "IDamageable.cs",
        "HealthComponent.cs",
        "UIHealthBar.cs"
      ],
      "inputs": [
        "DamagePayload (amount, attackerId, hitVector)",
        "CurrentHealth state variable"
      ],
      "process_execution_plan": [
        "1. Intercept raycast or collider hit via IDamageable interface",
        "2. Subtract damage amount from CurrentHealth",
        "3. Clamp health between 0 and MaxHealth",
        "4. Update UIHealthBar progress bar fill",
        "5. If CurrentHealth <= 0, trigger OnDeath event and disable character controller"
      ],
      "outputs": [
        "Updated CurrentHealth",
        "UI Health Bar value refresh",
        "OnDeath event signal"
      ],
      "status": "DESIGN"
    },
    {
      "id": "node_web_auth_login",
      "title": "Web Auth: User Login Route Handler",
      "category": "API Route Handler",
      "lifecycle_phase": "HTTP_POST /api/auth/login",
      "target_symbols": [
        "src/routes/auth.ts",
        "src/services/userService.ts",
        "src/utils/jwt.ts"
      ],
      "inputs": [
        "Req body: { email: string, password_hash: string }",
        "Supabase Client / PostgreSQL DB connection"
      ],
      "process_execution_plan": [
        "1. Validate email format and request schema using Zod",
        "2. Query database for user record matching email",
        "3. Verify password hash using bcrypt/argon2",
        "4. Generate JWT access_token and refresh_token",
        "5. Set HttpOnly auth cookie and return user profile DTO"
      ],
      "outputs": [
        "HTTP 200 OK with UserProfile object",
        "Set-Cookie header with HTTPOnly JWT",
        "HTTP 401 Unauthorized error fallback"
      ],
      "status": "IMPLEMENTED"
    },
    {
      "id": "node_web_auth_middleware",
      "title": "Web Auth: Session Validation Middleware",
      "category": "Client Hook / State",
      "lifecycle_phase": "HTTP Request Middleware",
      "target_symbols": [
        "src/middleware/authGuard.ts",
        "src/stores/useAuthStore.ts"
      ],
      "inputs": [
        "Authorization Bearer header or HttpOnly cookie",
        "JWT Secret Key"
      ],
      "process_execution_plan": [
        "1. Extract token from request header or cookie",
        "2. Verify JWT signature and expiration timestamp",
        "3. Attach decoded UserSession object to Request context",
        "4. Reject unauthenticated requests with HTTP 403 Forbidden"
      ],
      "outputs": [
        "Populated req.user state context",
        "Next() middleware call",
        "HTTP 403 error response"
      ],
      "status": "READY_FOR_IMPLEMENTATION"
    }
  ]
