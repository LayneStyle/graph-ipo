{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GraphIPOCanvasState",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "active_profile": { "type": "string", "enum": ["UNITY_GAMEDEV", "WEB_FULLSTACK", "DATA_PIPELINE"] },
    "phase": { "type": "string", "enum": ["MACRO_DESIGN", "NODE_DRILLDOWN", "SPECIFIED", "IMPLEMENTATION", "AUDIT"] },
    "code_language": { "type": "string", "enum": ["EN", "ES", "CUSTOM"], "default": "EN" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "lifecycle_phase": { "type": "string" },
          "target_symbols": { "type": "array" },
          "inputs": { "type": "array" },
          "process_execution_plan": { "type": "array" },
          "outputs": { "type": "array" },
          "status": { "type": "string", "enum": ["DESIGN", "READY_FOR_IMPLEMENTATION", "IMPLEMENTED", "NEEDS_REVISION"] }
        },
        "required": ["id", "title", "status"]
      }
    }
  },
  "required": ["version", "active_profile", "phase", "nodes"]
}
